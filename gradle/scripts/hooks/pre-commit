#!/bin/sh

echo "Running pre-commit release checks..."

# Run the Gradle verification task
# We use --no-configuration-cache to ensure it picks up the latest version changes
./gradlew verifyRelease --no-configuration-cache

if [ $? -ne 0 ]; then
    echo "ERROR: Release verification failed. Commit aborted."
    echo "Please ensure changelogs, migrations, and README are updated for the current version."
    exit 1
fi

echo "✓ Release verification passed."
